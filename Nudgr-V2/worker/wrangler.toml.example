name = "nudgr-r2-worker"
main = "index.js"
compatibility_date = "2024-01-01"

# Bind your Cloudflare R2 bucket
[[r2_buckets]]
binding = "VOICE_BUCKET"
bucket_name = "nudgr-voice"

# Environment Variables (set secrets via `wrangler secret put <KEY>`)
# - FIREBASE_PROJECT_ID
# - R2_ACCOUNT_ID
# - R2_ACCESS_KEY_ID
# - R2_SECRET_ACCESS_KEY
